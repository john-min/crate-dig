# Copy to .env and fill in. Never commit .env.

# Supabase
SUPABASE_PROJECT_REF=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DATABASE_URL=

# Google OAuth
GOOGLE_OAUTH_WEB_CLIENT_ID=
GOOGLE_OAUTH_WEB_CLIENT_SECRET=

# Google Cloud
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_PROJECT_NUMBER=
GCP_REGION=us-west1
GCP_ARTIFACT_REGISTRY_LOCATION=us-west1
GCP_ARTIFACT_REGISTRY_REPOSITORY=crate-dig
GCP_ANALYSIS_SERVICE_ACCOUNT=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_API_TOKEN=
R2_BUCKET_AUDIO=crate-dig-audio-dev
R2_ENDPOINT=

# Cloud Run Job / local analyze-run (optional; flag also works)
# ANALYSIS_RUN_ID=
# CRATEDIG_JOB_WORKDIR=/tmp/cratedig-analyze

# Vercel / site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Google Analytics 4 (public). Loaded only in production builds.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-38JH1QX8HH

# Web runtime selection. Safe default uses checked-in synthetic fixtures.
NEXT_PUBLIC_APP_MODE=mock

# Used only when NEXT_PUBLIC_APP_MODE=local.
NEXT_PUBLIC_LOCAL_API_URL=http://127.0.0.1:8000

# Required when NEXT_PUBLIC_APP_MODE=cloud; leave empty in mock/local development.
NEXT_PUBLIC_CLOUD_API_URL=

# Prototype web access gate (server only; never NEXT_PUBLIC_). Fail-closed if unset.
# Local/Vercel example value: THONGLOR — set in .env.local / Vercel env, not here.
ACCESS_CODE=
