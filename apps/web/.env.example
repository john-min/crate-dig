# Copy to .env.local. Never commit .env.local.
# Values can match the repo-root .env.example.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Google Analytics 4. Loaded only in production builds.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-38JH1QX8HH
# mock | preview | local | cloud. Use preview to play R2 audio without Supabase.
NEXT_PUBLIC_APP_MODE=mock

# Local disk playback (apps/local-api on 127.0.0.1:8000)
NEXT_PUBLIC_LOCAL_API_URL=http://127.0.0.1:8000

# Hosted Cloud Run API (cloud mode). Leave empty to use same-origin Next /api/cloud mediation.
NEXT_PUBLIC_CLOUD_API_URL=

# Prototype access gate (server only; never NEXT_PUBLIC_). Fail-closed if unset.
ACCESS_CODE=

# Cloudflare R2 (server only; never NEXT_PUBLIC_). Required for signed upload/playback.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_AUDIO=crate-dig-audio-dev
R2_ENDPOINT=
