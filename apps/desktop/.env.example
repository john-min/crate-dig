# Copy to .env only if you need to override defaults. Desktop never reads
# SUPABASE_SECRET_KEY / service-role keys — do not add them here.

# Sidecar: auto connects to a healthy loopback API, otherwise supervises one.
# CRATE_DIG_SIDECAR_MODE=auto
# CRATE_DIG_SIDECAR_URL=http://127.0.0.1:8000
# CRATE_DIG_HOME=
# CRATE_DIG_ISOLATED_HOME=1
# CRATE_DIG_API_PORT=8000

# Optional cloud sync (loaded only after the user enables it in the UI).
# CRATE_DIG_SUPABASE_URL=
# CRATE_DIG_SUPABASE_PUBLISHABLE_KEY=
