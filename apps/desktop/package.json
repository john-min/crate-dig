{
  "name": "desktop",
  "productName": "Crate Dig",
  "version": "0.0.0",
  "private": true,
  "description": "Crate Dig Electron desktop shell (Forge + Vite/React)",
  "main": ".vite/build/main.js",
  "scripts": {
