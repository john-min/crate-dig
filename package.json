{
  "name": "crate-dig",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "contracts:openapi": "uv run --python 3.12 --project apps/local-api python scripts/export_local_api_openapi.py",
    "contracts:generate": "pnpm contracts:openapi && pnpm --filter @crate-dig/contracts generate",
    "contracts:check": "node scripts/check_contract_drift.mjs",
    "lint": "pnpm -r --if-present lint",
    "desktop": "pnpm --filter desktop start",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  }
}
